{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "brick_launcher",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "build",
      "command": ".\\brick_launcher.exe",
      "cwd": "${workspaceFolder}/build/bin"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "brick_launcher (lldb)",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/build/bin/brick_launcher.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build/bin",
      "terminal": "external",
      "stopOnEntry": false
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "brick_tests",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/build/bin/brick_tests.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build/bin"
    }
  ]
}
